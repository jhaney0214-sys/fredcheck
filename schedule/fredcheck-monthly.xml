<?xml version="1.0" encoding="UTF-8"?>
<!--
  FredCheck's monthly check as a Windows scheduled task. Not installed.
  Before registering, replace FREDCHECK_DIR (twice) with the folder that holds
  rerun.py; see schedule/README.md. It runs on the 15th at 07:30 as the user
  who registers it, only when that user is logged on, catches up if the
  machine was off, and needs a network connection.
-->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>FredCheck: rebuild the answer key from FRED's public data, flag questions whose ground truth changed, and rewrite RESULTS.md. Commits nothing.</Description>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-11-15T07:30:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByMonth>
        <DaysOfMonth>
          <Day>15</Day>
        </DaysOfMonth>
        <Months>
          <January /><February /><March /><April /><May /><June />
          <July /><August /><September /><October /><November /><December />
        </Months>
      </ScheduleByMonth>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>true</RunOnlyIfNetworkAvailable>
    <ExecutionTimeLimit>PT30M</ExecutionTimeLimit>
    <Enabled>true</Enabled>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>FREDCHECK_DIR\schedule\monthly.cmd</Command>
      <WorkingDirectory>FREDCHECK_DIR</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
